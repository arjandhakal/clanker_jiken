# Only for the optional "Summarize with AI" button; normal searches do not call a model.
# Otherwise use ~/.pi/agent/settings.json's default provider/model.
# SEARCH_PROVIDER=radius
# SEARCH_MODEL=balanced
# PORT=4317
# DATA_DIR=data
# PI_SEARCH_AGENT_DIR=/absolute/path/to/.pi/agent
# PI_RADIUS_GATEWAY=https://radius.pi.dev
# RADIUS_API_KEY=your-service-key
