{
  "name": "pi-markdown-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read Markdown in a local Pi overlay without adding it to model context.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
